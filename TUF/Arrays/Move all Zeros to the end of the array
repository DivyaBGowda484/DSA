Question: Move all Zeros to the end of the array

class Solution:
    def moveZeroes(self, arr):
        temp = [0] * len(arr)
        index = 0

        # Traverse input array
        for num in arr:
            # If non-zero, copy to temp
            if num != 0:
                temp[index] = num
                index += 1

        # Copy temp back to original
        for i in range(len(arr)):
            arr[i] = temp[i]

        # Return updated array
        return arr

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)

