Question: Find Second Smallest and Second Largest Element in an array

def getElements(arr, n):
    # Edge case: when the array has less than 2 elements
    if n == 0 or n == 1:
        print(-1, -1)
        return

    arr.sort()

    small = arr[1] # Incase of no duplicates

    large = arr[n - 2] # Incase of no duplicates

    print("Second smallest is", small)
    print("Second largest is", large)

# TIME COMPLEXITY: O(n logn)
# SPACE COMPLEXITY: O(1)

