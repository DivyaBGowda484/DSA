Question: Remove Duplicates in-place 

class Solution:
    def removeDuplicates(self, nums):
        seen = set()

        index = 0

        for num in nums:
            if num not in seen:
                seen.add(num)

                nums[index] = num

                index += 1
        return index

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)

# OPTIMIZED CODE:

class Solution:
    def removeDuplicates(self, nums):
        if not nums:
            return 0

        i = 0

        for j in range(1, len(nums)):
            if nums[j] != nums[i]:
                i += 1
                nums[i] = nums[j]

        return i + 1

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
