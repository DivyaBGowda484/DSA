Question: Find the Largest element in an array

def sortArr(arr):
    arr.sort()
    
    return arr[-1]

# TIME COMPLEXITY: O(n logn)
# SPACE COMPLEXITY: O(1)

# OPTIMIZED:

def findLargestElement(arr, n):
    max = arr[0]

    for i in range(1, n):
        if arr[i] > max:
            max = arr[i]

    return max

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
