def isSorted(arr, n):
    for i in range(n):
        for j in range(i + 1, n):
            if arr[j] < arr[i]:
                return False
    return True 

# TIME COMPLEXITY: O(n^2)
# SPACE COMPLEXITY: O(1)

# OPTIMIZED

def isSorted(arr, n):
    for i in range(1, n):
        if arr[i] < arr[i - 1]:
            return False
    return True  

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
