Question: Check if the given String is Palindrome or not (https://leetcode.com/problems/valid-palindrome)

def palindrome(i, s):
    if i >= len(s) // 2:
        return True

    if s[i] != s[len(s) - i - 1]:
        return False

    return palindrome(i + 1, s)

# TIME COMLEXITY: O(N)
# SPACE COMPLEXITY: O(N)
