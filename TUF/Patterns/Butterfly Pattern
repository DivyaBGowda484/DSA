Question:

*        *
**      **
***    ***
****  ****
**********
****  ****
***    ***
**      **
*        *


Solution:

n = 5

# Upper half
spaces = 2 * n - 2
for i in range(1, n + 1):

    # Left stars
    for j in range(i):
        print("*", end="")

    # Middle spaces
    for j in range(spaces):
        print(" ", end="")

    # Right stars
    for j in range(i):
        print("*", end="")

    spaces -= 2
    print()

# Lower half
spaces = 2
for i in range(n - 1, 0, -1):

    # Left stars
    for j in range(i):
        print("*", end="")

    # Middle spaces
    for j in range(spaces):
        print(" ", end="")

    # Right stars
    for j in range(i):
        print("*", end="")

    spaces += 2
    print()
