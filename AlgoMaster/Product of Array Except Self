Question 238: Product of Array Except Self (https://leetcode.com/problems/product-of-array-except-self)

class Solution:
    def productExceptSelf(self, nums: List[int]) -> List[int]:

# DID NOT UNDERSTAD

        answer = []
        for i in range(len(nums)):
            n = len(nums)
        res = [1] * n

        prefix = 1
        for i in range(n):
            res[i] = prefix
            prefix *= nums[i]

        suffix = 1
        for i in range(n - 1, -1, -1):
            res[i] *= suffix
            suffix *= nums[i]

        return res

# TIME COMPLEXITY: O(n)
# SPACE COMPLXITY: O(1)
