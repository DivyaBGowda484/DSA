Question 151: Reverse Words in a String (https://leetcode.com/problems/reverse-words-in-a-string)

class Solution:
    def reverseWords(self, s: str) -> str:
        words = s.strip().split()          
        return ' '.join(reversed(words))

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n) - for list of words
