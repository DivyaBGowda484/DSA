Question 283: Move Zeroes (https://leetcode.com/problems/move-zeroes)

class Solution:
    def moveZeroes(self, nums: List[int]) -> None:
        """
        Do not return anything, modify nums in-place instead.
        """
        '''result = []
        
        # Copy non-zero elements
        for num in nums:
            if num != 0:
                result.append(num)

        # Count zeros and add to result
        zero_count = len(nums) - len(result)
        result.extend([0] * zero_count)

        # Copy back to original array
        for i in range(len(nums)):
            nums[i] = result[i]'''

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)

# OPTIMIZED APPROCH:
        j = 0  # position for next non-zero
    
        # Move non-zeroes to the front
        for i in range(len(nums)):
            if nums[i] != 0:
                nums[j] = nums[i]
                j += 1

        # Fill remaining positions with 0
        for i in range(j, len(nums)):
            nums[i] = 0

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
