Question 26: Remove Duplicates from Sorted Array (https://leetcode.com/problems/remove-duplicates-from-sorted-array)

class Solution:
    def removeDuplicates(self, nums: List[int]) -> int:
        j=1  #j is 1 since the first element in the array is always unique and doesn't need to be changed.
        for i in range(1,len(nums)):
            if nums[i] != nums[i-1]:
                nums[j] = nums[i]
                j+=1
        return j

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)

