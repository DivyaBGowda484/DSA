Question 20: Valid Parentheses (https://leetcode.com/problems/valid-parentheses)

class Solution:
    def isValid(self, s: str) -> bool:
        '''stack = []
        mapping = {')': '(', ']': '[', '}': '{'}

        for char in s:
            if char in mapping:
                top_element = stack.pop() if stack else '#'
                if mapping[char] != top_element:
                   return False
            else:
                stack.append(char)

        return not stack'''

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)

        stack = []

        for char in s:
            if char == '(':
                stack.append(')')
            elif char == '{':
                stack.append('}')
            elif char == '[':
                stack.append(']')
            elif not stack or stack.pop() != char:
                return False

        return not stack

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)
