Question 217: Contains Duplicate (https://leetcode.com/problems/contains-duplicate)

class Solution:
    def containsDuplicate(self, nums: List[int]) -> bool:
        # return len(nums) != len(set(nums))

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)

        seen = set()
        for num in nums:
            if num in seen:
                return True
            seen.add(num)
        return False

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)
