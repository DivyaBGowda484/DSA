Question: Floor in BST (https://www.geeksforgeeks.org/problems/floor-in-bst/1)
NOTE: Floor: the largest value in the BST less than or equal to x.

#User function Template for python3

class Solution:
    def floor(self, root, x):
        # Code here
        res = -1
        while root:
            if root.data == x:
                return root.data
            elif root.data < x:
                res = root.data
                root = root.right
            else:
                root = root.left
        return res
        
# TIME COMPLEXITY: O(n)
# SPACE COMPLEXIITY: O(1)
