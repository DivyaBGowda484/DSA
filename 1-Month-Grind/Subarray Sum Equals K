Question 560: Subarray Sum Equals K (https://leetcode.com/problems/subarray-sum-equals-k)

class Solution:
    def subarraySum(self, nums: List[int], k: int) -> int:
        count = 0
        for i in range(len(nums)):
            curr_sum = 0
            for j in range(i, len(nums)):
                curr_sum += nums[j]
                if curr_sum == k:
                    count += 1
        return count

# TIME COMPLEXITY: O(n^2)
# SPACE COMPLEXITY: O(1)

