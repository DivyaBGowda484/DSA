Question 128: Longest Consecutive Sequence (https://leetcode.com/problems/longest-consecutive-sequence)

class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        num_set = set(nums)
        longest = 0

        for num in num_set:
            # only start counting if it's the start of a sequence
            if num - 1 not in num_set:
                current_num = num
                current_streak = 1

                # count consecutive numbers
                while current_num + 1 in num_set:
                    current_num += 1
                    current_streak += 1

                longest = max(longest, current_streak)

        return longest

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)
