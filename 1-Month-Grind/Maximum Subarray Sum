Question: Maximum Subarray Sum (https://www.naukri.com/code360/problems/maximum-subarray-sum_630526)

def maxSubarraySum(arr, n):
    max_sum = current_sum = 0

    for i in range(n):
        current_sum += arr[i]
        if current_sum < 0:
            current_sum = 0
        max_sum = max(max_sum, current_sum)

    return max_sum

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
