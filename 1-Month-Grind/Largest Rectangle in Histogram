Question 84: Largest Rectangle in Histogram (https://leetcode.com/problems/largest-rectangle-in-histogram)

class Solution:
    def largestRectangleArea(self, heights: List[int]) -> int:
        stack = []  # stack will store indices
        max_area = 0
        n = len(heights)

        for i in range(n + 1):
            current_height = heights[i] if i < n else 0

            while stack and (i == n or heights[stack[-1]] > current_height):
                height = heights[stack.pop()]
                width = i if not stack else i - stack[-1] - 1
                max_area = max(max_area, height * width)

            stack.append(i)

        return max_area

# TIME COMPLEXITY: O(n)
# SPAACE COMPLEXITY: O(n)

