Question: Weather Observation Station 5 (https://www.hackerrank.com/challenges/weather-observation-station-5/problem?isFullScreen=true)

-- Smallest city name (alphabetically first if tie)
SELECT CITY, LENGTH(CITY)
FROM STATION
ORDER BY LENGTH(CITY), CITY
LIMIT 1;

-- Largest city name (alphabetically first if tie)
SELECT CITY, LENGTH(CITY)
FROM STATION
ORDER BY LENGTH(CITY) DESC, CITY
LIMIT 1;
