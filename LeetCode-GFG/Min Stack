# TIME COMPLEXITY: O(1)
# SPACE COMPLEXITY: O(n)

    def __init__(self):
        self.stack = []

    def push(self, val: int) -> None:
        if not self.stack:
            self.stack.append((val, val))
        else:
            self.stack.append((val, min(val, self.stack[-1][1])))

    def pop(self) -> None:
        self.stack.pop()

    def top(self) -> int:
        return self.stack[-1][0]

    def getMin(self) -> int:
        return self.stack[-1][1]

# TIME COMPLEXITY: O(1)
# SPACE COMPLEXITY: O(n)



