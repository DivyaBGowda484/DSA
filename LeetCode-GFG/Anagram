Question: Anagram (https://www.geeksforgeeks.org/problems/anagram-1587115620/1)

class Solution:
    def areAnagrams(self, s1, s2):
       # code here
        '''if len(s1) != len(s2):
            return False
        
        # Sort both strings
        s1 = sorted(s1)
        s2 = sorted(s2)
        
        # Compare sorted strings
        return s1 == s2'''
        
# TIME COMPLEXITY: O(n log n)
# SPACE COMPLEXITY: O(n)

        # If lengths differ, not anagrams
        if len(s1) != len(s2):
            return False
        
        # Frequency array for 26 lowercase letters
        freq = [0] * 26
        
        # Count chars from s1 and subtract for s2
        for ch1, ch2 in zip(s1, s2):
            freq[ord(ch1) - ord('a')] += 1
            freq[ord(ch2) - ord('a')] -= 1
        
        # If all counts are zero → anagram
        return all(f == 0 for f in freq)
        
# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
