Question 387: First Unique Character in a String (https://leetcode.com/problems/first-unique-character-in-a-string)

from collections import Counter

class Solution:
    def firstUniqChar(self, s: str) -> int:
        '''freq = [0] * 26
        for ch in s:
            freq[ord(ch) - ord('a')] += 1
        
        for i, ch in enumerate(s):
            if freq[ord(ch) - ord('a')] == 1:
                return i
        return -1'''

# TIME OMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)

        freq = Counter(s)
        for i, ch in enumerate(s):
            if freq[ch] == 1:
                return i
        return -1

# TIME OMPLEXITY: O(n)
