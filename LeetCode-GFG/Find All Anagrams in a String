# Using Fixed Array for Frequencies:
        res = []
        m, n = len(p), len(s)
        if m > n:
            return res
        
        # frequency arrays
        p_count = [0] * 26
        window_count = [0] * 26
        
        # fill frequency arrays for p and first window in s
        for i in range(m):
            p_count[ord(p[i]) - ord('a')] += 1
            window_count[ord(s[i]) - ord('a')] += 1
        
        # check first window
        if p_count == window_count:
            res.append(0)
        
        # slide window
        for i in range(m, n):
            window_count[ord(s[i]) - ord('a')] += 1
            window_count[ord(s[i - m]) - ord('a')] -= 1
            
            if p_count == window_count:
                res.append(i - m + 1)
        
        return res

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
