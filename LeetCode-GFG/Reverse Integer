Question 7: Reverse Integer (https://leetcode.com/problems/reverse-integer?envType=problem-list-v2&envId=a0h7ydue)

class Solution:
    def reverse(self, x: int) -> int:
        sign = -1 if x < 0 else 1
        reversed_str = str(abs(x))[::-1]   # Str() takes log n time and also creates new str of d characters so log n space
        reversed_int = sign * int(reversed_str)

        if -2**31 <= reversed_int <= 2**31 - 1:
            return reversed_int
        else:
            return 0

# TIME COMPLEXITY: O(log n)
# SPACE COMPLEXITY: O(log n)

        result = 0
        sign = -1 if x < 0 else 1
        x = abs(x)

        while x != 0:
            digit = x % 10 # Extracts the last digit of x.
            x //= 10

            # Check for overflow before adding digit
            if result > (2**31 - 1) // 10:
                return 0

            result = result * 10 + digit

        return sign * result

# TIME COMPLEXITY: O(log n)
# SPACE COMPLEXITY: O(1)
