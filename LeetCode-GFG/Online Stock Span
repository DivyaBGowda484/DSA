Question 901: Online Stock Span (https://leetcode.com/problems/online-stock-span)

class StockSpanner:

    def __init__(self):
        self.stack = []

    def next(self, price: int) -> int:
        span = 1
        # Pop smaller/equal prices and add their spans
        while self.stack and self.stack[-1][0] <= price:
            span += self.stack.pop()[1]
        # Push current price and span
        self.stack.append((price, span))
        return span

 # TIME COMPLEXITY: O(1)
 # SPACE COMPLEXITY: O(n)


