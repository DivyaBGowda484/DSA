# TIME COMPLEXITY: O(1)
# SPACE COMPLEXITY: O(1)

        """if n <= 0:
            return False
        
        while n % 3 == 0:
            n //= 3
        
        return n == 1"""

# TIME COMPLEXITY: O(log n)
# SPACE COMPLEXITY: O(1)

        if n <= 0:
            return False
        
        log_val = math.log10(n) / math.log10(3)
        return log_val.is_integer()

