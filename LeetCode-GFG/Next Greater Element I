Question 496: Next Greater Element I (https://leetcode.com/problems/next-greater-element-i?envType=problem-list-v2&envId=eeudwo2i)

class Solution:
    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:
        result = []

        for num in nums1:
            idx = nums2.index(num)
            found = -1
            for i in range(idx+1, len(nums2)):
                if nums2[i] > num:
                    found = nums2[i]
                    break
            result.append(found)
        return result

# TIME COMPLEXITY: O(m*n)
# SPACE COMPLEXITY: O(m)

