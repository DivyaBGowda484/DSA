Question 24: Find Pivot Index (https://leetcode.com/problems/find-pivot-index)

class Solution:
    def pivotIndex(self, nums: List[int]) -> int:

# Brute force:
        '''for i in range(len(nums)):
            left = sum(nums[:i])
            right = sum(nums[i+1:])
            if left == right:
                return i
        return -1'''

# TIME COMPLEXITY: O(n^2)
# SPACE COMPLEXITY: O(1)

#  Prefix Sum:
        total = sum(nums)
        left_sum = 0
        
        for i in range(len(nums)):
            if left_sum == total - left_sum - nums[i]:
                return i
            left_sum += nums[i]
        
        return -1

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
