Question 3159: Find Occurrences of an Element in an Array (https://leetcode.com/problems/find-occurrences-of-an-element-in-an-array)

class Solution:
    def occurrencesOfElement(self, nums: List[int], queries: List[int], x: int) -> List[int]:
        # Collect indices of x
        indices = [i for i, val in enumerate(nums) if val == x]
        
        # Answer each query
        ans = []
        for q in queries:
            if q <= len(indices):
                ans.append(indices[q-1])
            else:
                ans.append(-1)
        return ans

# TIME COMPLEXITY: O(n+m)
# SPACE COMPLEXITY: O(n+m)
