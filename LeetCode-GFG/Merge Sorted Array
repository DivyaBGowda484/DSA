Question 88: Merge Sorted Array (https://leetcode.com/problems/merge-sorted-array?envType=problem-list-v2&envId=eeudwo2i)

class Solution:
    def merge(self, nums1: List[int], m: int, nums2: List[int], n: int) -> None:
        """
        Do not return anything, modify nums1 in-place instead.
        """

# BRUTE FORCE:

        """for i in range(n):
            nums1[m + i] = nums2[i]
        
        nums1.sort()"""

# TIME COMPLEXITY: O((m + n) log(m + n))
# SPACE COMPLEXITY: O(1)

# OPTIMIZED:

        # Pointers for nums1, nums2, and the end of the merged array
        i = m - 1
        j = n - 1
        k = m + n - 1

        # Merge from the end to the beginning
        while i >= 0 and j >= 0:
            if nums1[i] > nums2[j]:
                nums1[k] = nums1[i]
                i -= 1
            else:
                nums1[k] = nums2[j]
                j -= 1
            k -= 1

        # If nums2 still has elements left, copy them
        while j >= 0:
            nums1[k] = nums2[j]
            j -= 1
            k -= 1

# TIME COMPLEXITY: O(m+m)
# SPACE COMPLEXITY: O(1)
