Question 503: Next Greater Element II (https://leetcode.com/problems/next-greater-element-ii)

class Solution:
    def nextGreaterElements(self, nums: List[int]) -> List[int]:
        n = len(nums)
        res = [-1] * n
        for i in range(n):
            for j in range(1, n):  # check next n-1 elements circularly
                if nums[(i + j) % n] > nums[i]:
                    res[i] = nums[(i + j) % n]
                    break
        return res

# TIME COMPLEXITY: O(n^2)
# SPACE COMPLEXITY: O(1)

