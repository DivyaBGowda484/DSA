Question: Floor in a Sorted Array (https://www.geeksforgeeks.org/problems/floor-in-a-sorted-array-1587115620/1)

class Solution:
    def findFloor(self, arr, x):
        low, high = 0, len(arr) - 1
        floor_index = -1

        while low <= high:
            mid = low + (high - low) // 2
            if arr[mid] <= x:
                floor_index = mid   # candidate (<= x)
                low = mid + 1       # try to find a later (larger) index
            else:
                high = mid - 1

        return floor_index

# TIME COMPLEXITY: O(log n)
# SPACE COMPLEXITY: O(1)
