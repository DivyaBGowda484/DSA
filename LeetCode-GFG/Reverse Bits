Question 190: Reverse Bits (https://leetcode.com/problems/reverse-bits?envType=problem-list-v2&envId=a0h7oz3h)

class Solution:
    def reverseBits(self, n: int) -> int:
        '''result = 0
        for _ in range(32):
            result = (result << 1) | (n & 1)
            n >>= 1
        return result'''

# TIME COMPLEXITY: O(1)
# SPACE COMPLEXITY: O(1)

        '''b = bin(n)[2:]                # convert to binary string
        b = b.zfill(32)               # pad with leading zeros to make 32 bits
        b = b[::-1]                   # reverse string
        return int(b, 2)'''

# TIME COMPLEXITY: O(1)
# SPACE COMPLEXITY: O(1)

        return int(f'{n:032b}'[::-1], 2)

# TIME COMPLEXITY: O(1)
# SPACE COMPLEXITY: O(1)
