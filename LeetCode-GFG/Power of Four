Question 432: Power of Four (https://leetcode.com/problems/power-of-four?envType=problem-list-v2&envId=recursion)

class Solution:
    def isPowerOfFour(self, n: int) -> bool:
        """for x in range(0, 32):
            if n == 4**x:
                return True
        return False"""

# TIME COMPLEXITY: O(1)
# SPACE COMPLEXITY: O(1)

        """if n <= 0:
            return False
        while n % 4 == 0:
            n //= 4
        return n == 1"""

# TIME COMPLEXITY: O(log n)
# SPACE COMPLEXITY: O(1)

        return n > 0 and (n & (n - 1)) == 0 and (n & 0x55555555) != 0 #Keeps only the bits of n that are in even positions.

# TIME COMPLEXITY: O(1)
# SPACE COMPLEXITY: O(1)
