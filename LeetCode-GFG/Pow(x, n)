Question 50: Pow(x, n) (https://leetcode.com/problems/powx-n?envType=problem-list-v2&envId=a0h7ydue)

class Solution:
    def myPow(self, x: float, n: int) -> float:
# INTUTION: - If ( n ) is even: ( x^n = (x^{n/2})^2 )  
#           - If ( n ) is odd:  ( x^n = x cdot x^{n-1} )
        def fast_pow(base: float, exponent: int) -> float:
            if exponent == 0:
                return 1.0
            half = fast_pow(base, exponent // 2)
            return half * half if exponent % 2 == 0 else half * half * base

        if n < 0:
            x = 1 / x
            n = -n
        return fast_pow(x, n)
