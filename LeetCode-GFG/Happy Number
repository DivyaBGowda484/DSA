Question 202: Happy Number (https://leetcode.com/problems/happy-number)

class Solution:
    def isHappy(self, n: int) -> bool:

# Using a Set to Detect Cycle:
        def get_next(num):
            total_sum = 0
            while num > 0:
                digit = num % 10
                total_sum += digit ** 2
                num //= 10
            return total_sum

        seen = set()
        while n != 1 and n not in seen:
            seen.add(n)
            n = get_next(n)

        return n == 1

# TIME COMPLEXITY: O(log n)
# SPACE COMPLEXITY: O(k)
