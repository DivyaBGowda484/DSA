Question 118: Pascal's Triangle (https://leetcode.com/problems/pascals-triangle?envType=problem-list-v2&envId=eeudwo2i)

class Solution:
    def generate(self, numRows: int) -> List[List[int]]:
        '''triangle = []

        for i in range(numRows):
            row = [1] * (i + 1)  # row with 1s
            for j in range(1, i):  # fill middle elements
                row[j] = triangle[i-1][j-1] + triangle[i-1][j]
            triangle.append(row)

        return triangle'''

# TIME COMPLEXITY: O(n^2)
# SPACE COMPLEXITY: O(n^2)

