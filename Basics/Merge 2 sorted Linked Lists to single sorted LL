# Create 2 linked list of n and m sizes such that n !=m and merge the list to a sorted list. For ease create linked list in sorted fashion with increment of 2.

class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class LinkedList:
    def __init__(self):
        self.head = None
    
    def insert(self, data):    #O(n) O(n)
        new_node = Node(data)
        if self.head is None:
            self.head = new_node
        else:
            current = self.head
            while current.next:
                current = current.next
            current.next = new_node
        
    def display(self):    #O(n) O(1)
        current = self.head
        while current:
            print(current.data, end=" -> ")
            current = current.next
        print("None")

def create_linked_lists():
    n = int(input("Enter the size of the first linked list: "))
    m = int(input("Enter the size of the second linked list: "))
    
    linked_list1 = LinkedList()
    linked_list2 = LinkedList()

    # Creating two sorted linked lists    #O(n^2)
    for i in range(n):
        linked_list1.insert(i * 2)  # Inserts even numbers
    for i in range(m):
        linked_list2.insert(i * 2 + 1)  # Inserts odd numbers

    # Handling edge cases where one or both lists are empty
    if linked_list1.head is None and linked_list2.head is None:
        print("Both lists are empty!")
        return
    elif linked_list1.head is None:
        print("Merged Sorted Linked List:")
        linked_list2.display()
        return
    elif linked_list2.head is None:
        print("Merged Sorted Linked List:")
        linked_list1.display()
        return
    
    # Merging the two linked lists
    merged_list = merge_linked_lists(linked_list1, linked_list2)
    
    print("Merged Sorted Linked List:")
    merged_list.display()

def merge_linked_lists(linked_list1, linked_list2):    #O(n) O(n)
    dummy_node = Node(0)  # Dummy node to form the merged list
    tail = dummy_node

    list1_node = linked_list1.head
    list2_node = linked_list2.head

    # Merging the lists in sorted order
    while list1_node and list2_node:
        if list1_node.data < list2_node.data:
            tail.next = list1_node
            list1_node = list1_node.next
        else:
            tail.next = list2_node
            list2_node = list2_node.next
        tail = tail.next

    # Append the remaining nodes from either list
    if list1_node:
        tail.next = list1_node
    if list2_node:
        tail.next = list2_node

    merged_list = LinkedList()
    merged_list.head = dummy_node.next  # The merged list starts from dummy_node.next (0 not included)
    return merged_list


create_linked_lists()

# TIME COMPLEXITY: O(n^2)
# SPACE COMPLEXITY: O(n)
