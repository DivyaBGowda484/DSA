# Merge two sorted arrays to a single sorted array

import numpy as np
arr1 = np.array(list(map(int, input("Enter numbers seperated by space: ").split())))
arr2 = np.array(list(map(int, input("Enter numbers seperated by space: ").split())))


# To get single sorted array    (TIME COMPLEXITY: O(n logn))
combined_arr = np.concatenate((arr1, arr2))
single_sorted = np.sort(combined_arr)
print(single_sorted)

# TIME COMPLEXITY: O(n logn)
