# Sort an List

# To take list of numbers as input
no = int(input("Enter how many numbers you want to enter: "))
while no == 0:
    print("Try entering a number greater than 0 to check if it is sorted!")
    no = int(input("Enter how many numbers you want to enter: "))
else:
    given_list = []
    for i in range(no):
        num = input("Enter a number: ")
        if '.' in num:
            given_list.append(float(num))
        else:
            given_list.append(int(num))


# To sort using in-built methords by changing original list    (TIME COMPLEXITY: O(n logn))
if given_list == sorted(given_list):
    print("The elements in list are already sorted!")
else:
    given_list.sort()
    print(given_list)


# To sort using in-built methords without altering original list    (TIME COMPLEXITY: O(n logn))
if given_list == sorted(given_list):
    print("The elements in list are already sorted!")
else:
    sorted_list = sorted(given_list)
    print(sorted_list)


# To sort the list without using in-built methods    (TIME COMPLEXITY: O(n^2))
for i in range(0, len(given_list)):
    for j in range(i+1, len(given_list)):
        if given_list[j] < given_list[i]:
            given_list[j], given_list[i] = given_list[i], given_list[j]
            
print(given_list)


#TIME COMPLEXITY: O(n logn)
