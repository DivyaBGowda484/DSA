Question: Count frequency of each element in the array 

def countFreq(arr, n):
    visited = [False] * n

    for i in range(n):
        if visited[i]:
            continue

        count = 1
        for j in range(i + 1, n):
            if arr[i] == arr[j]:
                visited[j] = True  # Mark arr[j] as processed
                count += 1

        print(arr[i], count)

# TIME COMPLEXITY: O(n^2)
# SPACE COMPLEXITY: O(n)

(or)

from collections import defaultdict

class Solution:
    def Frequency(self, arr, n):
        freq_map = defaultdict(int)

        for i in range(n):
            freq_map[arr[i]] += 1

        for key, value in freq_map.items():
            print(key, value)

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)
