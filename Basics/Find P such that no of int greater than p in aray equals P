# Given a integer array A, Find P exists in A such that no of int greater than p in aray equals P

# To fetch Array as a user input 
A = []
N = int(input("Enter the number od elements you want to enter: "))
for i in range(N):
    num = int(input("Enter element: "))
    A.append(num)


# To find P     (TIME COMPLEXITY: O(n logn))
sorted_arr = sorted(A)
n = len(sorted_arr)
def find_P(A):
    for i in range(n):
        num_greater = n - i - 1
        if sorted_arr[i] == num_greater:
            # Ensure the next element is last or is different to avoid duplicates
            if i == n-1 or sorted_arr[i] != sorted_arr[i + 1]:
                return 1
    return -1

result = find_P(sorted_arr)
print(result)

