# Given an array of integers and a integer number k, your task is to find the maximum sum of subarray of size k


# To take the input from the user
arr = list(map(int, input("Enter space seperated integer numbers: ").split()))
k = int(input("Enter the size of the subarray: "))


# To find the max sum of subarray of size k
max_sum = 0
arr_len = len(arr) # T:O(1)

if arr_len < k:
    print("Subarray size k is larger than the array size")
else:
    current_sum = sum(arr[:k]) #T:O(n)
    max_sum = current_sum

    for i in range(1, arr_len - k + 1): #T:O(n)
        current_sum = current_sum - arr[i - 1] + arr[i + k - 1]
        max_sum = max(max_sum, current_sum)

print("Maximum sum of subarray of size", k, "is:", max_sum)

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
