# Given an integer array A of size N and an integer B, print the array after rotating it B times towards the right.

# To get user input 
A = input("Enter numbers seperated by space: ").split()
while not A:
    print("Try entering some numbers!")
    A = input("Enter numbers seperated by space: ").split()
B = int(input("Enter a integer for B: "))
N = len(A)

# To do right shift by B times    (TIME COMPLEXITY: O(n))
if B > N:
    B = B % N
    A = A[-B:] + A[:-B]

else:
    A = A[B:] + A[:B]

print(A)

# TIME COMPLEXITY: O(n)
