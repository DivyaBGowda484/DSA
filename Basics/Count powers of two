# given: A list of +ve integers. Your task is to count how many numbers in the list can be represented as a power of 2, such as 1 (= 2⁰), 2 (= 2¹), 4 (= 2²), 8 (= 2³), etc.

def count_powers_of_two(numbers):
    count = 0
    for num in numbers:
        if (num & (num - 1)) == 0:
            count += 1
    return count

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
