# Given an array A of size N, return the difference between max even and min odd numbers of that array

# To take user input for integer array A of size N
import numpy as np
N = int(input("Enter the number of elements you want to enter: "))
A = []
for i in range(N):
    num = int(input("Enter element " + str(i+1) + ": "))
    A.append(num)


# To return the difference between max even and min odd numbers
def max_min_diff(A):
    max_even = None
    min_odd = None

    for num in A:
        if num % 2 == 0:  
            if max_even is None or num > max_even:
                max_even = num
        else:
            if min_odd is None or num < min_odd:
                min_odd = num

    if max_even is not None and min_odd is not None:
        return max_even - min_odd
    else:
        return 0

max_min_diff()
