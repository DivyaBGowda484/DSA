# Create 2 linked list of n and m sizes such that n !=m and merge the list to a sorted list. For ease create linked list in sorted fashion with increment of 2.

class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class LinkedList:
    def __init__(self):
        self.head = None
    
    def insert(self, data):
        new_node = Node(data)
        if self.head == None:
            self.head = new_node
        else:
            current = self.head
            while current.next:
                current = current.next
            current.next = new_node
        
    def display(self):
        current = self.head
        while current:
            print(current.data, end=" ")
            current = current.next
        

