# Merging two LinkedLists:
def merge_linked_lists(linked_list1, linked_list2):
    dummy_node = Node(0)  # Dummy node to form the merged list
    tail = dummy_node

    list1_node = linked_list1.head
    list2_node = linked_list2.head

    # Merging the lists in sorted order
    while list1_node and list2_node:
        if list1_node.data < list2_node.data:
            tail.next = list1_node
            list1_node = list1_node.next
        else:
            tail.next = list2_node
            list2_node = list2_node.next
        tail = tail.next

    # Append the remaining nodes from either list
    if list1_node:
        tail.next = list1_node
    if list2_node:
        tail.next = list2_node

    merged_list = LinkedList()
    merged_list.head = dummy_node.next  # The merged list starts from dummy_node.next
    return merged_list


