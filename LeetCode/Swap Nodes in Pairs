        # BASE CASE: If there are 0 or 1 nodes left, return as-is
        if not head or not head.next:
            return head

        first = head
        second = head.next

        # Recursive call to swap the rest of the list
        first.next = self.swapPairs(second.next)

        # Actual swap of current two nodes
        second.next = first

        # second is the new head of the swapped pair
        return second

