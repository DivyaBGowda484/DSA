Question 1876: Substrings of Size Three with Distinct Characters (https://leetcode.com/problems/substrings-of-size-three-with-distinct-characters)

class Solution:
    def countGoodSubstrings(self, s: str) -> int:
        count = 0
        for i in range(len(s) - 2):  # loop till len(s)-2 to get a substring of length 3    
            substring = s[i:i+3]
            if len(set(substring)) == 3:
                count += 1
        return count


# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
