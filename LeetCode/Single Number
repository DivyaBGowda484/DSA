Question 136: Single Number (https://leetcode.com/problems/single-number)

class Solution:
    def singleNumber(self, nums: List[int]) -> int:
        """for i in nums:
            if nums.count(i) == 1:  #T: O(n) -> count
                return i"""
        # TIME COMPLEXITY: O(n^2)
        # SPACE COMPLEXITY: O(1)

        unique_no = 0
        for num in nums:
            unique_no ^= num
        return unique_no
        
# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
