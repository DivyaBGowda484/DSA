Question 1957: Delete Characters to Make Fancy String (https://leetcode.com/problems/delete-characters-to-make-fancy-string?envType=daily-question&envId=2025-07-21)

class Solution:
    def makeFancyString(self, s: str) -> str:
        res = []
        count = 1

        for i in range(1, len(s)):
            if s[i] == s[i - 1]:
                count += 1
            else:
                count = 1

            if count < 3:
                res.append(s[i - 1])

        # append the last character (it may be missing)
        res.append(s[-1])
        return "".join(res)

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)
