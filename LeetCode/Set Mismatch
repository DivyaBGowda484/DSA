Question 645: Set Mismatch (https://leetcode.com/problems/set-mismatch?envType=problem-list-v2&envId=eeudwo2i)

class Solution:
    def findErrorNums(self, nums: List[int]) -> List[int]:
        """n = len(nums)
        count = [0] * (n + 1)   # count from 1 to n

        for num in nums:
            count[num] += 1     # count each number

        for i in range(1, n + 1):
            if count[i] == 2:   # duplicate found
                duplicate = i
            elif count[i] == 0: # missing number
                missing = i

        return [duplicate, missing]"""

'''EXPLANATION : (count[num] += 1)
count[1] += 1 → count = [0, 1, 0, 0, 0]
count[2] += 1 → count = [0, 1, 1, 0, 0]
count[2] += 1 → count = [0, 1, 2, 0, 0]
count[4] += 1 → count = [0, 1, 2, 0, 1]
then we check which has 2 and which has zero'''

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)

# OPTIMIZED:

        n = len(nums)

        sum_nums = sum(nums)
        sum_set = sum(set(nums))
        sum_ideal = n * (n + 1) // 2

        duplicate = sum_nums - sum_set
        missing = sum_ideal - sum_set

        return [duplicate, missing]

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
