Question 1480: Running Sum of 1d Array (https://leetcode.com/problems/running-sum-of-1d-array)

class Solution:
    def runningSum(self, nums: List[int]) -> List[int]:
        '''res = []
        total = 0
        for num in nums:
            total += num
            res.append(total)
        return res'''

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(n)

        for i in range(1, len(nums)):
            nums[i] += nums[i - 1]
        return nums

# TIME COMPLEXITY: O(n)
# SPACE COMPLEXITY: O(1)
